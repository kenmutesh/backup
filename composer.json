{
    "name": "ken/LaravelBackup",
    "description": "A package to help create database backup and files",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ken\\Backup\\": "src/"
        }
    },
  "extra": {
    "laravel": {
      "providers": [
        "Ken\\LaravelBackup\\BackupServiceProvider"
      ],
      "aliases": {
        "Backup": "Ken\\LaravelBackup\\Facades\\Backup"
      }
    }
  },
    "authors": [
        {
            "name": "kenmutesh",
            "email": "kenmutesh901@gmail.com"
        }
    ],
  "require": {
        "php": "^8.0",
        "illuminate/database": "^9.0|^10.0|^11.0",
        "illuminate/filesystem": "^9.0|^10.0|^11.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "league/flysystem-ziparchive": "^3.31",
        "spatie/db-dumper": "^3.0"
    },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "optimize-autoloader": true
  }
}
